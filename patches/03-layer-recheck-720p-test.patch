+	/* Геометрия 720p должна извлекаться из vdec_status так же, как 1080p/4K. */
+	{
+		vdec_chan_t one [VDEC_MAX_CHANNELS];
+		assert (vdec_parse_channels ("  device name : ammvdec_h264_v4\n"
