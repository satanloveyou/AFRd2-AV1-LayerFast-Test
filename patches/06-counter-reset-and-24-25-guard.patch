diff --git a/vdec.c b/vdec.c
--- a/vdec.c
+++ b/vdec.c
@@ -220,6 +220,18 @@ int vdec_read (const char *path, vdec_status_t *out, vdec_sel_t *st)
 	return 0;
 }
 
+bool vdec_same_signature (const vdec_status_t *a, const vdec_status_t *b)
+{
+	return a && b && a->active && b->active &&
+	       (strcmp (a->device, b->device) == 0) &&
+	       (a->decl_dur == b->decl_dur) &&
+	       (a->decl_fps == b->decl_fps);
+}
