+		b.status = 5;
+		assert (vdec_same_signature (&a, &b));
+		b.decl_dur = 4004;
+		assert (!vdec_same_signature (&a, &b));
+		b.decl_dur = 3200;
+		snprintf (b.device, sizeof (b.device), "%s", "amvdec_av1_v4l");
+		assert (!vdec_same_signature (&a, &b));
