 bool fps_group_differs (int a_hz, int b_hz);
 
+/* Защита от обратной связи декодера с текущим режимом дисплея.
+ * Когда экран уже работает на 24/25 Гц, счётчик может повторять частоту
+ * экрана, а не контента. Без независимого подтверждения не переключаемся
+ * между 24 и 25: удерживаем текущий режим. */
+int fps_guard_display_feedback (int measured_hz, int display_hz,
+                                int declared_hz, bool api_hint,
+                                bool layer_pinned);
