+/* Два активных снимка относятся к одной сигнатуре декодера. Счётчик кадров
+ * и status намеренно не сравниваются: они могут сбрасываться/меняться при
+ * перезапуске счётчика или паузе, не означая смену видеопотока. */
+bool vdec_same_signature (const vdec_status_t *a, const vdec_status_t *b);
