+/* На 24/25 Гц счётчик декодера иногда синхронизируется с экраном.
+ * Такое измерение не доказывает смену контента: без свежей подсказки API,
+ * закреплённой частоты слоя или совпадающей декларации держим текущий режим.
+ * Вне спорной зоны (или при дисплее 50/60 Гц) обычное решение не меняем. */
+int fps_guard_display_feedback (int measured_hz, int display_hz,
+                                int declared_hz, bool api_hint,
+                                bool layer_pinned)
+{
+	if (api_hint || layer_pinned ||
+	    (measured_hz <= 0) || (display_hz <= 0))
+		return measured_hz;
+
+	if ((measured_hz < 23 * 256) || (measured_hz > 27 * 256) ||
+	    (display_hz < 23 * 256) || (display_hz > 27 * 256))
+		return measured_hz;
+
+	if (!fps_group_differs (display_hz, measured_hz))
+		return measured_hz;
+
+	/* Совпадающая декларация подтверждает измерение независимо от дисплея. */
+	if ((declared_hz > 0) && !fps_group_differs (declared_hz, measured_hz))
+		return measured_hz;
+
+	return display_hz;
+}
