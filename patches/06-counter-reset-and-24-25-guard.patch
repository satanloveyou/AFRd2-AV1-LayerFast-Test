--- /dev/null
+++ b/tests/test_fps_display_guard.c
@@ -0,0 +1,37 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../fps_class.h"
+
+int main (void)
+{
+	const int hz24 = fps_rate_hz (1);
+	const int hz25 = fps_rate_hz (2);
+	const int hz60 = fps_rate_hz (7);
+	const int hz30 = fps_rate_hz (4);
+
+	/* Без независимой опоры не переключаем 24/25 вслед за дисплеем. */
+	assert (fps_guard_display_feedback (hz24, hz25, hz30, false, false) == hz25);
+	assert (fps_guard_display_feedback (hz25, hz24, hz30, false, false) == hz24);
+
+	/* Декларация того же класса подтверждает измерение. */
+	assert (fps_guard_display_feedback (hz24, hz25, hz24, false, false) == hz24);
+	assert (fps_guard_display_feedback (hz25, hz24, hz25, false, false) == hz25);
+
+	/* Свежая подсказка API и закреплённая частота слоя сильнее guard. */
+	assert (fps_guard_display_feedback (hz24, hz25, hz30, true, false) == hz24);
+	assert (fps_guard_display_feedback (hz25, hz24, hz30, false, true) == hz25);
+
+	/* За пределами 24/25 Гц обычный AFR не ограничивается. */
+	assert (fps_guard_display_feedback (hz24, hz60, hz30, false, false) == hz24);
+	assert (fps_guard_display_feedback (hz60, hz25, hz30, false, false) == hz60);
+
+	/* 23.976 и 24 входят в одну группу: это не повод удерживать режим. */
+	assert (fps_guard_display_feedback (fps_rate_hz (0), hz24, hz30,
+	                                    false, false) == fps_rate_hz (0));
+
+	/* Нулевые/неизвестные значения не должны создавать режим. */
+	assert (fps_guard_display_feedback (hz24, 0, 0, false, false) == hz24);
+
+	puts ("fps display feedback guard: OK");
+	return 0;
+}
