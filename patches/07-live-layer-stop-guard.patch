+
+bool fps_layer_present_recent (unsigned long long now_ns,
+                               unsigned long long present_ns,
+                               unsigned int max_age_ms)
+{
+	if (!now_ns || !present_ns || !max_age_ms || (present_ns > now_ns))
+		return false;
+
+	return (now_ns - present_ns) <=
+	       (unsigned long long) max_age_ms * 1000000ULL;
+}
