+/* Свежий timestamp отличает живую видеоподачу от старой истории latency:
+ * после паузы dumpsys всё ещё хранит прежние интервалы, но present timestamp
+ * последнего кадра уже не обновляется. */
+static bool atv14_layer_present_active (unsigned int max_age_ms)
+{
+	double p = 0.0, a = 0.0;
+	int n = 0;
+	unsigned long long last_ns = 0;
+	struct timespec ts;
+
+	if (!atv14_layer_stats (&p, &a, NULL, NULL, NULL, &n, 0, 150, NULL,
+	                        &last_ns) || (n < 2) || !last_ns)
+		return false;
+
+	if (clock_gettime (CLOCK_MONOTONIC, &ts) != 0)
+		return false;
+
+	unsigned long long now_ns = (unsigned long long) ts.tv_sec * 1000000000ULL +
+	                            (unsigned long long) ts.tv_nsec;
+	return fps_layer_present_recent (now_ns, last_ns, max_age_ms);
+}
 
