--- /dev/null
+++ b/tests/test_fps_layer_present_recent.c
@@ -0,0 +1,20 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../fps_class.h"
+
+int main (void)
+{
+	const unsigned long long now = 10000000000ULL;
+
+	assert (fps_layer_present_recent (now, now, 750));
+	assert (fps_layer_present_recent (now, now - 750000000ULL, 750));
+	assert (fps_layer_present_recent (now, now - 749000000ULL, 750));
+	assert (!fps_layer_present_recent (now, now - 751000000ULL, 750));
+	assert (!fps_layer_present_recent (now, now + 1ULL, 750));
+	assert (!fps_layer_present_recent (now, 0, 750));
+	assert (!fps_layer_present_recent (0, now, 750));
+	assert (!fps_layer_present_recent (now, now, 0));
+
+	puts ("fps layer present freshness: OK");
+	return 0;
+}
