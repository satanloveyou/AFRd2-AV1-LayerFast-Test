+/* Android 10/11 (SDK 29/30) на Amlogic переключают режим через SystemControl.
+ * Проба SurfaceFlinger 1035 на этих версиях может дать ложноположительный
+ * ответ: транзакция существует, но имеет другую семантику и не является AFR
+ * backdoor. Поэтому выбор backend делаем по SDK, а не по результату этой
+ * пробы. Если getprop недоступен, сохраняем прежнее автоопределение. */
+static int android_sdk_version (void)
+{
+	char sdk [32] = { 0 };
+	if (exec_capture ("getprop ro.build.version.sdk", sdk, sizeof (sdk)) != 0)
+		return 0;
+	return atoi (sdk);
+}
